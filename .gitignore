# ==============================================================================
# OSCA System - Root .gitignore
# ==============================================================================

# Node / NPM / Package Managers
node_modules/
frontend/node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Vite Cache & Frontend Distributable Outputs
.vite/
frontend/.vite/
frontend/dist/
frontend/dist-ssr/
*.local

# Laravel Vendor & Runtime Cache
backend/vendor/
backend/.env
backend/.env.backup
backend/.env.production
backend/auth.json
backend/.phpunit.result.cache
backend/.phpunit.cache
backend/.phpactor.json
backend/Homestead.json
backend/Homestead.yaml

# Laravel Storage & Logs (keep folder structure via .gitignore)
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/storage/pail/*
backend/storage/*.key
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/storage/app/private/*
!backend/storage/app/private/.gitignore

# Laravel Public Symlinks & Hot Reload
backend/public/storage
backend/public/hot
backend/public/build

# Database Exports & Local Data Files (PII Protection)
*.sql
*.sqlite
*.sqlite-journal
*.db
*.xlsx
*.csv
*.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.fleet/
.nova/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
